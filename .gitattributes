# Line endings: LF in the repository and in every working tree.
* text=auto eol=lf

# Generated; collapsed in GitHub diffs.
package-lock.json linguist-generated
agents-lock.json linguist-generated

# Development-only files, left out of source archives (git archive, GitHub's
# "Download ZIP"). The published package is controlled by package.json "files".
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.serena export-ignore
/opencode.json export-ignore
# Skills this repository's own coding agents install; not part of the tool.
/agents.yaml export-ignore
/agents-lock.json export-ignore
