{
  "name": "@xedinunknown/agents-config",
  "version": "0.0.0",
  "description": "Declarative dependency manager for AI coding agent skills and subagents",
  "type": "module",
  "packageManager": "npm@9.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XedinUnknown/agents-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agents-config": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "agents-config": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
